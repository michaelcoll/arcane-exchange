#include "Shared.xcconfig"

// NOTE: "//" starts a comment in xcconfig, so the slashes must be split with "$()" between them.
// Points at the local Nuxt dev server (`mise run front`), which proxies the API under /api/v1 and
// serves the card images under /card-images: the app resolves image paths against the origin of
// this URL (see CardArtwork). The base URL is overridable at runtime from Settings ▸ Arcane
// Exchange ▸ URL de l'API (see AppConfig); the CLERK_PUBLISHABLE_KEY of your Local.xcconfig must
// match the instance the backend validates against.
API_BASE_URL = http:/$()/localhost:3000/api/v1
