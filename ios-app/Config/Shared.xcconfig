PRODUCT_BUNDLE_IDENTIFIER = fr.piconsoft.arcane-exchange
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
// Lets ArcaneExchangeCore's `package` declarations be seen by the app, the widgets and the tests (ADR 0025).
SWIFT_PACKAGE_NAME = arcane-exchange
CODE_SIGN_STYLE = Automatic

// Per-developer values, never committed: the signing identity and the Clerk instance the
// build talks to. Copy Local.xcconfig.example to Local.xcconfig and fill both in.
//
// The empty default below keeps `$(CLERK_PUBLISHABLE_KEY)` resolvable without that file, so
// a fresh clone — and CI — still builds and tests. Clerk traps on a blank key: the app then
// leaves it unconfigured and shows a "missing key" screen (`ClerkSetup.configure`).
CLERK_PUBLISHABLE_KEY =

#include? "Local.xcconfig"
