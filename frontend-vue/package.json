{
  "name": "frontend-vue",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "serve:maquette": "npx -y http-server ../maquette -p 4000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --check \"../**/*.{ts,mjs,vue,json,css,yml,md}\"",
    "format:fix": "prettier --write --list-different \"../**/*.{ts,mjs,vue,json,css,yml,md}\"",
    "typecheck": "nuxi typecheck",
    "eslint": "eslint --max-warnings 0 .",
    "lint": "pnpm run typecheck && pnpm run eslint",
    "test": "vitest run"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clerk/nuxt": "~3.1.3",
    "@clerk/vue": "~2.5.3",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/fonts": "~0.14.0",
    "@nuxt/icon": "~2.5.1",
    "@nuxtjs/tailwindcss": "~6.14.0",
    "@sentry/nuxt": "~10.75.2",
    "@vueuse/nuxt": "~15.0.0",
    "eslint": "~10.10.0",
    "nuxt": "~4.5.2",
    "nuxt-security": "~2.6.0",
    "vue": "~3.5.43",
    "vue-router": "~5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "~4.3.2",
    "@types/node": "~24.1.0",
    "@vue/test-utils": "~2.5.1",
    "eslint-config-prettier": "~10.1.8",
    "happy-dom": "~20.14.5",
    "prettier": "~3.9.9",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "typescript": "~6.0.3",
    "vitest": "~5.0.1",
    "vue-tsc": "~3.3.11"
  }
}
