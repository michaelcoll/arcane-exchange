{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "serve:maquette": "npx -y http-server ../maquette -p 4000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --check \"../**/*.{ts,mjs,vue,json,css,yml,md}\"",
    "format:fix": "prettier --write --list-different \"../**/*.{ts,mjs,vue,json,css,yml,md}\"",
    "typecheck": "nuxi typecheck",
    "eslint": "eslint --max-warnings 0 .",
    "lint": "pnpm run typecheck && pnpm run eslint",
    "test": "vitest run"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@clerk/nuxt": "~3.1.29",
    "@clerk/vue": "~2.5.26",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/fonts": "~1.2.0",
    "@nuxt/icon": "~2.6.3",
    "@nuxtjs/tailwindcss": "~6.14.0",
    "@sentry/nuxt": "~11.14.0",
    "@vueuse/nuxt": "~15.0.0",
    "eslint": "~10.15.0",
    "nuxt": "~4.6.4",
    "nuxt-security": "~2.7.0",
    "vue": "~3.5.46",
    "vue-router": "~5.5.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "~4.4.0",
    "@types/node": "~26.6.6",
    "@vue/test-utils": "~2.6.0",
    "eslint-config-prettier": "~10.1.8",
    "happy-dom": "~21.0.4",
    "prettier": "~3.10.1",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "typescript": "~6.0.3",
    "vitest": "~5.1.1",
    "vue-tsc": "~3.3.14"
  }
}
