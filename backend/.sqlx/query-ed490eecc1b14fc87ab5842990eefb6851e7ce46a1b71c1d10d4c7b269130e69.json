  "db_name": "PostgreSQL",
  "query": "\n            SELECT p.id, p.kind, p.amount_cents, p.purchased_on, p.product_type, p.name,\n                   p.set_code, sn.name AS \"set_name?\"\n            FROM purchase p\n                     LEFT JOIN set_name sn ON sn.set_code = p.set_code\n            WHERE p.id = $1\n              AND p.user_id = $2\n            ",
