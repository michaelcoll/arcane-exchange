  "query": "\n        SELECT id,\n               foil,\n               binder_id AS \"binder_id?\",\n               quantity,\n               purchase_price,\n               COALESCE(added_at, NOW()) AS \"added_at!\"\n        FROM collection_entry\n        WHERE user_id = $1 AND set_code = $2 AND collector_number = $3 AND language_code = $4\n        ORDER BY id\n        FOR UPDATE\n        ",
