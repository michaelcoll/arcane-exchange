    "quantity": 1,
    "binder_id": null
  }
}

docs {
  `201`. Merges into the existing entry of the same card, finish and binder. Set `binder_id` to
  `{{binderId}}` to store the copies in a binder. `card_not_in_catalog` (404),
  `invalid_quantity` (400, outside 1 to 255).
}
