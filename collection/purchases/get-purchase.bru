meta {
  name: get purchase
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/purchases/{{purchaseId}}
  body: none
  auth: inherit
}

docs {
  The purchase with its content (each line with its current trend price), the value of the
  content, the lines without trend price and the profitability against the amount.
  `purchase_not_found` (404), also for a purchase of another player.
}
