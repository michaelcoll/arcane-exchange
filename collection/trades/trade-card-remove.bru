meta {
  name: remove trade card
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/trades/{{tradeId}}/cards/remove
  body: json
  auth: inherit
}

body:json {
  {
    "set_code": "ECL",
    "collector_number": "166",
    "language_code": "FR",
    "foil": false,
    "owner_username": "{{otherUsername}}"
  }
}
